SELECT 
	project_company,
	nerd_id,
	nerd_role,
	hours_rate AS rate_original,
	hours_rate - 5 AS rate_drop,
	hours_rate + 5 AS rate_hike
FROM invoices_fact;



SELECT 
	project_company,
	nerd_id,
	nerd_role,
	hours_spent,
	hours_rate AS rate_original,
	hours_rate - 5 AS rate_drop,
	hours_rate + 5 AS rate_hike
FROM invoices_fact;




SELECT 
	project_company,
	nerd_id,
	nerd_role,
	hours_spent,
	hours_rate AS rate_original,
	hours_rate + 5 AS rate_hike,
	(hours_rate + 5) * hours_spent AS project_total
FROM invoices_fact
WHERE
	rate_hike * hours_spent > 1000;

-- project total (after hike) = rate_hike * hours_spent





SELECT 
	project_company,
	nerd_id,
	nerd_role,
	hours_spent,
	hours_rate AS rate_original,
	hours_rate + 5 AS rate_hike,
	(hours_rate + 5) * hours_spent AS project_total
FROM invoices_fact
WHERE
	project_total > 1000
ORDER BY project_total DESC;




